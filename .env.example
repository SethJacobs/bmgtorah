# Copy to .env.local (local dev) and add the same values in your host's dashboard.

# Public site URL (used in RSS feeds and login emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose

# Cloudflare R2 → create bucket "bmgtorah-media", then R2 API token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bmgtorah-media
# Public URL for the bucket: r2.dev URL while testing, later a custom domain like https://media.bmgtorah.org
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-XXXX.r2.dev

# Podcast feed details
PODCAST_OWNER_EMAIL=office@example.org
