# Copy to .env.local (local dev) and add the same values in your host's dashboard.

# Public site URL (used in RSS feeds and login emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never expose

# File storage (any S3-compatible service). Backblaze B2 example:
#   B2 › Buckets › your bucket shows the S3 endpoint, e.g. s3.us-east-005.backblazeb2.com
#   B2 › Application Keys › Add a key with Read and Write on that bucket
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY_ID=            # B2 "keyID"
S3_SECRET_ACCESS_KEY=        # B2 "applicationKey" (server only)
S3_BUCKET=bmgtorah-media
# Public base URL for files in the bucket (B2 "Friendly URL" up to the bucket name):
NEXT_PUBLIC_MEDIA_BASE_URL=https://f005.backblazeb2.com/file/bmgtorah-media

# Podcast feed details
PODCAST_OWNER_EMAIL=office@example.org
